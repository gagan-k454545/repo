{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "src/app/api/public/stream/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/staff/stream/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/staff/bills/[id]/invoice.pdf/route.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(public|staff)/stream",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-transform"
        },
        {
          "key": "X-Accel-Buffering",
          "value": "no"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
